//-----------------------------------------------------------------------------
//	KASANE_LAUNCHER.VPC
//
//	Project Script
//-----------------------------------------------------------------------------

$MacroRequired "PLATSUBDIR"

$Macro SRCDIR		".."
$Macro OUTBINDIR	"$SRCDIR\..\game\bin" [$WIN32]
$Macro OUTBINDIR	"$SRCDIR\..\game\bin\x64" [$WIN64]

$Macro OUTBINNAME		"kasane"
$Macro OUTBINNAME		"$OUTBINNAME_win64"		[$WIN64]
$Macro OUTBINNAME       "$OUTBINNAME_osx"		[$OSXALL]
$Macro OUTBINNAME       "$OUTBINNAME_linux"		[$LINUX32]
$Macro OUTBINNAME       "$OUTBINNAME_linux64"	[$LINUX64]

$Conditional GAME_OUTPUT		"1"

$Include "$SRCDIR\vpc_scripts\source_exe_base.vpc"

$Configuration	"Debug"
{
	$General
	{
		// Windows generator doesn't sandbox these directories per configuration but others do :-/
		$OutputDirectory			".\Debug_$OUTBINNAME_win32" [$WIN32]
		$OutputDirectory			".\Debug_$OUTBINNAME_win64" [$WIN64]
		$IntermediateDirectory		".\Debug_$OUTBINNAME_win32" [$WIN32]
		$IntermediateDirectory		".\Debug_$OUTBINNAME_win64" [$WIN64]
	}
}

$Configuration	"Release"
{
	$General
	{
		// Windows generator doesn't sandbox these directories per configuration but others do :-/
		$OutputDirectory			".\Release_$OUTBINNAME_win32" [$WIN32]
		$OutputDirectory			".\Release_$OUTBINNAME_win64" [$WIN64]
		$IntermediateDirectory		".\Release_$OUTBINNAME_win32" [$WIN32]
		$IntermediateDirectory		".\Release_$OUTBINNAME_win64" [$WIN64]
	}
}

$Configuration
{
	$Compiler
	{
		$AdditionalOptions					"/EHa"
		$PreprocessorDefinitions			"$BASE;VALVE;PROTECTED_THINGS_DISABLE;VERSION_SAFE_STEAM_API_INTERFACES;NO_WARN_MBCS_MFC_DEPRECATION;SLE"
		$TreatWarningsAsErrors				"False"
	}

	$Linker [$WIN32]
	{
		$EnableLargeAddresses	"Support Addresses Larger Than 2 Gigabytes (/LARGEADDRESSAWARE)"
	}
}

$Project "kasane_launcher"
{
	$Folder	"Source Files"
	{
		-$File	"$SRCDIR\public\tier0\memoverride.cpp"
		$File	"$SRCDIR\public\filesystem_init.cpp"
		$File	"$SRCDIR\public\filesystem_init.h"
		$File	"main.cpp"
	}

	$Folder	"Link Libraries" 
	{
		$Lib tier0
		$Lib tier1
		$Lib vstdlib
		$Lib appframework
		$Lib steam_api
	}
	
	$Folder "Resource Files"
	{
		$File   "hammer_launcher.rc"
		$File   "teto.ico"
		$File   "idr_manifest.ico"
	}
}
